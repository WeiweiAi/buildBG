{
  "CHEMICAL": {
    "description": "biochemical components",
    "physical_constants": {
      "R": {"description": "Universal gas constant", "units": "J_per_K_mol", "symbol": "R", "value": 8.314},
      "F": {"description": "Faraday's constant", "units": "C_per_mol", "symbol": "F", "value": 96485},
      "T": {"description": "Absolutetemperature", "units": "kelvin", "symbol": "T", "value": 298.15}
    },
    "domain_variables": {
      "effort": {"description": "chemical potential", "units": "J_per_mol", "symbol": "mu"},
      "flow": {"description": "molar flow", "units": "fmol_per_s", "symbol": "v"},
      "quantity": {"description": "molar quantity", "units": "fmol", "symbol": "q"}
    },
    "components": {
      "Re": {
        "description": "biochemical reaction",
        "parameters": {
          "kappa": {"description": "reaction rate", "units": "fmol_per_s", "value": 1, "symbol": "kappa"}
        },
        "constitutive_equations": [
          "f_0 - kappa*(exp(e_0/R/T) - exp(e_1/R/T))",
          "f_0 - f_1"
        ]
      },
      "Re_GHK": {
        "description": "biochemical reaction with GHK equation",
        "parameters": {
          "kappa": {"description": "reaction rate", "units": "fmol_per_s", "value": 1, "symbol": "kappa"}
        },
        "constitutive_relations": [
          "f_0- Piecewise(( kappa*(exp(e_0/R/T) - exp(e_1/R/T)),s_3==0),(kappa*(s_3/R/T/(exp(s_3/R/T)))*((exp(e_0/R/T) - exp(e_1/R/T))),s_3!=0))",
          "f_0-f_1"
          ]
      },
      "Ce": {
        "description": "chemical species",
        "parameters": {
          "K": {"description": "thermodynamic constant", "units": "per_fmol", "symbol": "K", "value": 1}
        },
        "constitutive_equations": [
          "e_0 - R*T*log(K*q_0)",
          "ode(q_0,t) - f_0"
        ]
      },
      "Se": {
        "description": "chemostat",
        "parameters": {
          "K": {"description": "thermodynamic constant", "units": "per_fmol", "symbol": "K", "value": 1},
          "q_0": {"description": "fixed quantity", "units": "fmol", "symbol": "q_0", "value": 1}
        },
        "constitutive_equations": [
          "e_0 - R*T*log(K*q_0)"
        ]
      }
    }
  },

  "ELECTRICAL": {
    "description": "electrical components",
    "domain_variables": {
      "effort": {"description": "voltage", "units": "volt", "symbol": "u"},
      "flow": {"description": "current", "units": "fA", "symbol": "i"},
      "quantity": {"description": "charge", "units": "fC", "symbol": "q"},
      "momentum": {"description": "magnetic flux linkage", "units": "volt_s", "symbol": "p"}
    },
    "components": {
      "R": {
        "description": "linear resistor",
        "parameters": {
          "R": {"description": "resistance", "value": 1, "units": "pOhm", "symbol": "R"}
        },
        "constitutive_equations": ["e_0 - f_0*R"]
      },
      "C": {
        "description": "linear capacitor",
        "parameters": {
          "C": {"description": "capacitance", "value": 1, "units": "fF", "symbol": "C"}
        },
        "constitutive_equations": ["q_0 - C * e_0", "ode(q_0,t) - f_0"]
      },
      "I": {
        "description": "linear inductor",
        "parameters": {
          "L": {"description": "inductance", "value": 1, "units": "pH", "symbol": "L"}
        },
        "constitutive_equations": ["p_0 - L * f_0", "ode(p_0,t) - e_0"]
      },
      "Se": {
        "description": "voltage source",
        "parameters": {
          "u_0": {"description": "fixed voltage", "value": 1, "units": "volt", "symbol": "u_0"}
        },
        "constitutive_equations": ["e_0 - u_0"]
      },
      "Sf": {
        "description": "current source",
        "parameters": {
          "i_0": {"description": "fixed current", "value": 1, "units": "fA", "symbol": "i_0"}
        },
        "constitutive_equations": ["f_0 - i_0"]
    },
      "TF": {
        "description": "electrical transformer",
        "parameters": {
          "n": {"description": "turns ratio", "value": 1, "units": "dimensionless", "symbol": "n"}
        },
        "constitutive_equations": ["e_1 - n * e_0", "f_0 - n * f_1"]
      }
    }
  },
  "MECHANICAL_TRANSLATIONAL": {
    "description": "mechanical components",
    "domain_variables": {
      "effort": {"description": "force", "units": "J_per_um", "symbol": "F"},
      "flow": {"description": "velocity", "units": "um_per_s", "symbol": "v"},
      "quantity": {"description": "displacement", "units": "um", "symbol": "x"},
      "momentum": {"description": "momentum", "units": "J_s_per_um", "symbol": "p"}
    },
    "components": {
      "R": {
        "description": "linear damper",
        "parameters": {
          "eta": {"description": "viscosity", "value": 1, "units": "J_s_per_um2", "symbol": "eta"}
        },
        "constitutive_equations": ["e_0 - f_0*eta"]
      },
      "C": {
        "description": "linear capacitance",
        "parameters": {
          "C": {"description": "capacitance", "value": 1, "units": "um2_per_J", "symbol": "C"}
        },
        "constitutive_equations": [ "q_0 - C * e_0",  "ode(q_0,t) - f_0"]
      },
      "E": {
        "description": "linear spring",
        "parameters": {
          "k": {"description": "elastance", "value": 1, "units": "J_per_um2", "symbol": "k"}
        },
        "constitutive_equations": ["e_0 - k * q_0",  "ode(q_0,t) - f_0"]
      },
      "M": {
        "description": " mass",
        "parameters": {
          "m": {"description": "mass", "value": 1, "units": "J_s2_per_um2", "symbol": "m"}
        },
        "constitutive_equations": ["p_0 - m * f_0",  "ode(p_0,t) - e_0"]
      },
      "Se": {
        "description": "force source",
        "parameters": {
          "F_0": {"description": "fixed force", "value": 1, "units": "J_per_um", "symbol": "F_0"}
        },
        "constitutive_equations": ["e_0 - F_0"]
      },
      "Sf": {
        "description": "velocity source",
        "parameters": {
          "v_0": {"description": "fixed velocity", "value": 1, "units": "um_per_s", "symbol": "v_0"}
        },
        "constitutive_equations": ["f_0 - v_0"]
      }
    }
  },
  "HYDRAULIC": {
    "description": "hydraulic components",
    "domain_variables": {
      "effort": {"description": "pressure", "units": "mmHg", "symbol": "P"},
      "flow": {"description": "volum flow", "units": "mL_per_s", "symbol": "Q"},
      "quantity": {"description": "volume", "units": "mL", "symbol": "V"},
      "momentum": {"description": "momentum of a flow tube", "units": "mmHg_mL2_per_s3", "symbol": "p"}
    },
    "components": {
      "R": {
        "description": "linear resistance",
        "parameters": {
          "R": {"description": "resistance", "value": 1, "units": "mmHg_s_per_mL", "symbol": "R"}
        },
        "constitutive_equations": ["e_0 - f_0*R"]
      },
      "C": {
        "description": "linear compliance",
        "parameters": {
          "C": {"description": "compliance", "value": 1, "units": "mL_per_mmHg", "symbol": "C"}
        },
        "constitutive_equations": ["q_0 - C * e_0",  "ode(q_0,t) - f_0"]
      },
      "E": {
        "description": "linear elastance",
        "parameters": {
          "E": {"description": "elastance", "value": 1, "units": "mmHg_per_mL", "symbol": "E"}
        },
        "constitutive_equations": ["e_0 - E * q_0",  "ode(q_0,t) - f_0"]
      },
      "I": {
        "description": "linear inertance",
        "parameters": {
          "I": {"description": "inertance", "value": 1, "units": "mmHg_s2_per_mL", "symbol": "I"}
        },
        "constitutive_equations": ["p_0 - I * f_0",  "ode(p_0,t) - e_0"]
      },
      "Se": {
        "description": "pressure source",
        "parameters": {
          "P_0": {"description": "fixed pressure", "value": 1, "units": "mmHg", "symbol": "P_0"}
        },
        "constitutive_equations": ["e_0 - P_0"]
      },
      "Sf": {
        "description": "flow source",
        "parameters": {
          "Q_0": {"description": "fixed flow", "value": 1, "units": "mL_per_s", "symbol": "Q_0"}
        },
        "constitutive_equations": ["f_0 - Q_0"]
      }
    }
  },
  "ELECTROCHEMICAL": {
    "description": "multi-domain cross-coupling components",
    "physical_constants": {
      "F": {"description": "Faraday's constant", "value": 96485, "units": "C_per_mol", "symbol": "F"}
    },
    "components": {
      "zF": {
        "description": "biochemical-electrical transformer",
        "component_type": "TF",
        "port_domains": {
          "p1": "CHEMICAL",
          "p2": "ELECTRICAL"
        },
        "parameters": {
          "z": {"description": "Ratio", "value": 1, "units": "dimensionless", "symbol": "z"}
        },
        "constitutive_equations": [
          "e_1 - z * F * e_0",
          "f_0 - z * F * f_1"
        ]
      }
    }
  }
}